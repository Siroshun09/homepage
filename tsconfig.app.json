{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"lib": ["ES2023", "DOM"],
		"types": ["vite/client"],

		"moduleResolution": "Bundler",
		"isolatedModules": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js"
	},
	"include": ["src"]
}
